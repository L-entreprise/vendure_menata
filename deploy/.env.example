# ─── Menata Vendure — production environment ───────────────────────────────
# Copy to .env for local testing. In Coolify, set these as service env vars.
# NEVER commit a real .env (it is git-ignored).

# App
PORT=3000
# Comma-separated allowed CORS origins (your storefront + dashboard host).
# Leave empty to allow all (not recommended in prod).
CORS_ORIGIN=https://shop.menata.fr,https://admin.menata.fr
STOREFRONT_URL=https://shop.menata.fr

# Database (MariaDB / MySQL). Set DB=postgres to switch.
DB=mariadb
DB_HOST=
DB_PORT=3306
DB_NAME=vendure
DB_USERNAME=
DB_PASSWORD=
# Set to true for the VERY FIRST boot to create the schema, then set back to false.
# Prefer generating migrations once the schema is stable.
DB_SYNCHRONIZE=false

# Auth / secrets (REQUIRED — server refuses to boot without these)
COOKIE_SECRET=
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
REQUIRE_EMAIL_VERIFICATION=true

# Assets — point at a persistent Coolify volume so uploads survive redeploys.
ASSET_UPLOAD_DIR=/app/deploy/assets
# Public URL prefix for served assets (optional).
# ASSET_URL_PREFIX=https://shop.menata.fr/assets/

# Redis (optional). If REDIS_HOST is set, BullMQ job queue + Redis cache are used;
# otherwise the DB-polling job queue + in-memory cache.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email (optional). If SMTP_HOST is unset, a dev mailbox UI is served at /mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Menata" <noreply@menata.fr>

# Dashboard build-time API target (used by `vite build`).
VENDURE_API_PORT=3000

# Diagnostics plugin (optional). Set MENATA_DIAGNOSTIC_API_KEY to enable; the admin then
# shows this client's frozen web-diagnostic, proxied server-to-server from Menata.
# See plugins/diagnostics-plugin/README.md + MENATA-DIAGNOSTICS-ENDPOINT.md.
MENATA_API_BASE_URL=https://menata.fr
MENATA_DIAGNOSTIC_API_KEY=
MENATA_CLIENT_ID=
# Where the "order a diagnostic" CTA points when none/expired (optional).
DIAGNOSTICS_CTA_URL=https://menata.fr/diagnostic
# In-memory cache TTL in ms (optional, default 300000 = 5 min).
# DIAGNOSTICS_CACHE_TTL_MS=300000

# Plugins / features
AUDIT_LOG_RETENTION_DAYS=90
ENABLE_GRAPHIQL=false
ENABLE_SENTRY=false
SENTRY_DSN=
