{
    "name": "menata-vendure-deploy",
    "version": "1.0.0",
    "private": true,
    "description": "Minimal production deployment for the Menata Vendure store. Consumes @vendure/* from npm (precompiled) instead of building the monorepo fork. Plugins are shared from ../plugins (single source).",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "build:dashboard": "vite build",
        "start:server": "node -r ts-node/register/transpile-only -r dotenv/config index.ts",
        "start:worker": "node -r ts-node/register/transpile-only -r dotenv/config index-worker.ts",
        "migration:generate": "node -r ts-node/register/transpile-only -r dotenv/config migration.ts generate",
        "migration:run": "node -r ts-node/register/transpile-only -r dotenv/config migration.ts run",
        "migration:revert": "node -r ts-node/register/transpile-only -r dotenv/config migration.ts revert",
        "migrate:translations": "node -r ts-node/register/transpile-only -r dotenv/config migrate-translations.ts",
        "test:e2e": "vitest run --config vitest.config.mts"
    },
    "//": "Version ranges (~3.8.2) auto-track upstream patch releases so pulling official Vendure keeps working without edits. Bump the minor (e.g. ~3.9.0) to follow a new upstream minor.",
    "dependencies": {
        "@vendure-community/sentry-plugin": "^1.0.0",
        "@vendure/asset-server-plugin": "~3.8.2",
        "@vendure/common": "~3.8.2",
        "@vendure/core": "~3.8.2",
        "@vendure/dashboard": "~3.8.2",
        "@vendure/email-plugin": "~3.8.2",
        "@vendure/graphiql-plugin": "~3.8.2",
        "@vendure/job-queue-plugin": "~3.8.2",
        "bullmq": "^5.4.2",
        "dotenv": "^16.6.1",
        "ioredis": "^5.9.1",
        "mysql2": "^3.11.0",
        "sanitize-html": "^2.17.0"
    },
    "devDependencies": {
        "@swc/core": "^1.16.13",
        "@types/sanitize-html": "^2.16.2",
        "@vendure/testing": "~3.8.2",
        "sql.js": "^1.14.2",
        "ts-node": "^10.9.2",
        "typescript": "5.8.2",
        "unplugin-swc": "^1.6.0",
        "vite": "^7.3.1",
        "vitest": "^3.2.7"
    },
    "//overrides": "TanStack Router family pinned to exact versions known to work with the dashboard (unchanged ranges between Vendure 3.7.4 and 3.8.2); newer releases tightened route-id parsing and broke the dashboard before. @sentry/* forced to v11: @vendure-community/sentry-plugin 1.0.0 depends on @sentry/nestjs ^10, which peers NestJS <=11, while Vendure 3.8 runs on NestJS 12 (v11 supports it). Remove once the plugin ships a NestJS 12 release. The committed package-lock.json freezes the rest.",
    "overrides": {
        "@tanstack/react-router": "1.168.1",
        "@tanstack/react-router-devtools": "1.166.10",
        "@tanstack/router-core": "1.168.1",
        "@tanstack/router-generator": "1.166.15",
        "@tanstack/router-plugin": "1.167.1",
        "@tanstack/router-utils": "1.161.6",
        "@tanstack/virtual-file-routes": "1.161.7",
        "@tanstack/history": "1.161.6",
        "@sentry/nestjs": "^11.16.0",
        "@sentry/profiling-node": "^11.16.0"
    }
}
